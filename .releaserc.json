{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "./scripts/build-release.nu ${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["Casks/clawd-back.rb"],
        "message": "chore(release): ${nextRelease.version} cask [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "dist/ClawdBack-*-aarch64-darwin.zip",
            "label": "ClawdBack (aarch64-darwin)"
          }
        ]
      }
    ]
  ]
}
