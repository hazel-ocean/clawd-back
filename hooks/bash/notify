#!/usr/bin/env bash
# Stop + Notification: ping and stash the locator to claw you back. The app skips
# the banner when you are already looking at the session's window/pane.
set -euo pipefail
payload=$(cat)
app="$HOME/Applications/ClawdBack.app"
[ -d "$app" ] || exit 0

get() { printf '%s' "$payload" | /usr/bin/plutil -extract "$1" raw -o - - 2>/dev/null || true; }
sid=$(get session_id)
event=$(get hook_event_name)
message=$(get message)
transcript=$(get transcript_path)

# Title states the reason: the specific Notification message, or the finished
# state on Stop.
case "$event" in
  Notification) title=${message:-"Claude needs your input"} ;;
  *)            title="Claude has finished and is waiting" ;;
esac

# Body always carries Claude's last transcript text as color. The scan needs jq;
# without it the body is a nudge.
said=""
if [ -n "$transcript" ] && [ -f "$transcript" ] && command -v jq >/dev/null 2>&1; then
  said=$(tail -n 150 "$transcript" \
    | jq -rc 'select(.type=="assistant") | [.message.content[]? | select(.type=="text") | .text] | join(" ")' 2>/dev/null \
    | grep -v '^$' | tail -n 1 | tr '\n' ' ' | cut -c1-180 | sed 's/[[:space:]]*$//' || true)
fi
body=${said:-"Click to go check on Clawd"}

open "$app" --args notify --title "$title" --message "$body" --session-id "$sid"
